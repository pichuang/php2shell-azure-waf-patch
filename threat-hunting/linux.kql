let Lookback = 30d;
let PhpProcess = @"^php(?:-fpm|-cgi)?(?:[0-9]+(?:\.[0-9]+)*)?(?:-fpm|-cgi)?(?::.*)?$";
union
(
    DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where FileName matches regex PhpProcess
    | project Timestamp, DeviceId, DeviceName, Evidence = "PHP process",
              PhpFileName = FileName, PhpPath = FolderPath,
              PhpCommandLine = ProcessCommandLine,
              ObservedVersion = ProcessVersionInfoProductVersion
),
(
    union DeviceProcessEvents, DeviceFileEvents
    | where Timestamp > ago(Lookback)
    | where InitiatingProcessFileName matches regex PhpProcess
    | project Timestamp, DeviceId, DeviceName, Evidence = "PHP initiated activity",
              PhpFileName = InitiatingProcessFileName, PhpPath = InitiatingProcessFolderPath,
              PhpCommandLine = InitiatingProcessCommandLine,
              ObservedVersion = InitiatingProcessVersionInfoProductVersion
)
| summarize FirstSeen = min(Timestamp), LastSeen = max(Timestamp), Events = count(),
            Evidence = make_set(Evidence, 10), ObservedVersions = make_set(ObservedVersion, 20),
            CommandLines = make_set(PhpCommandLine, 20)
    by DeviceId, DeviceName, PhpFileName, PhpPath
| order by LastSeen desc